# Copy to .env (never commit it) or set these in your hosting dashboard.
PORT=3000
# The first owner account. Created/updated automatically at server start.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-long-password
# Gives ADMINS the built-in AI with no API key on their side (costs money on your Anthropic account).
ANTHROPIC_API_KEY=
# Optional: enables "Continue with Google". Create an OAuth Web client at console.cloud.google.com.
GOOGLE_CLIENT_ID=
# Where the JSON database is stored. Use a persistent disk in production.
DATA_DIR=./server/data
